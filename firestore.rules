rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The app-server/PostgreSQL session is the single trusted authority.
    // Legacy client-selected roles/schoolAccounts must grant no access.
    // STAGED CHANGE ONLY: back up/export legacy data and rehearse migration
    // before a separately approved rules deployment. Admin SDK bypasses rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
