# Example only. Configure actual values through the hosting platform's Secrets.
# This file is NOT loaded by the Express server automatically.
NODE_ENV=development
PORT=5000
EXPO_PUBLIC_DOMAIN=localhost:5000
DATABASE_URL=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Required before production image uploads. Mount a persistent volume here.
# Merely setting the boolean does not create a volume or a backup.
UPLOADS_DIR=
FILE_STORAGE_PERSISTENT=false
# Comma-separated exact HTTPS origins for browser upload/delete requests.
PUBLIC_WEB_ORIGINS=

# Current scope: one independent deployment for Ahbaballah.
# Enable only after applying server/dismissal-schema.sql to its database.
DISMISSAL_LEGACY_SINGLE_SCHOOL=false
DISMISSAL_SCHOOL_ID=ahbabullah
# Set the school's actual IANA timezone. This example is for a school in Sudan.
DISMISSAL_TIME_ZONE=Africa/Khartoum
