# ── Server (Express API) ─────────────────────────────────────────────
# REQUIRED in production: random secret (32+ chars) used to sign login tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DATABASE_URL=postgres://user:pass@host:5432/db
PORT=5000

# Optional: one-time initial admin password for the default school (must be changed at first login).
# If unset, the legacy "1234" is accepted ONCE and the admin is forced to change it.
ADMIN_INITIAL_PASSWORD=
# Optional: platform developer password (otherwise set from the developer panel).
DEVELOPER_PASSWORD=
# Optional: extra allowed CORS origins, comma separated (e.g. https://admin.example.com)
CORS_ORIGINS=

# Used by /api/auth/firebase-login to verify school-admin Firebase sessions.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# ── App (Expo, public — bundled into the app) ────────────────────────
EXPO_PUBLIC_DOMAIN=your-api-host.example.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
